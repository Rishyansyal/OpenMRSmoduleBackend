# Copy this file to .env and fill in real values.
# The real .env file is git-ignored. Keep credentials only in OneDrive / your local machine.

# --- Postgres ---
POSTGRES_USER=openmrs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openmrs
POSTGRES_PORT=5432

# --- API ---
# Tip: pak een vrije poort (8080 wordt vaak al gebruikt door andere stacks)
API_PORT=5111
ASPNETCORE_ENVIRONMENT=Development

# --- JWT ---
# Minimaal 32 tekens voor HMAC-SHA256
JWT_SECRET=change-me-to-a-long-random-secret-32chars

# --- CORS ---
# Komma-gescheiden lijst van toegestane frontend-origins.
# In productie: vervang door de HTTPS-URL van de frontend.
ALLOWED_ORIGINS=http://localhost:3001

# --- Messaging Providers ---
# Providers draaien via: docker run -p 1337:8080 ghcr.io/avansict/in2.4-fakecomworld:main
MESSAGING_STUDENT_GROUP=groep-1
MESSAGING_SWIFTSEND_APIKEY=your-api-key-here
# SecurePost, LegacyLink en AsyncFlow gebruiken standaard-credentials uit de docs.
# In productie overschrijven via Messaging__SecurePost__ClientSecret etc.

# --- Local (non-docker) override ---
# Only needed when running `dotnet run` outside docker-compose.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=openmrs;Username=openmrs;Password=change-me
# Jwt__SecretKey=change-me-to-a-long-random-secret-32chars
# Cors__AllowedOrigins=http://localhost:3000
