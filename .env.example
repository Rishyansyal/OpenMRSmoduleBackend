# Kopieer dit bestand naar .env en vul de echte waarden in.
# Het .env bestand is git-ignored. Bewaar credentials ALLEEN lokaal of in een wachtwoordmanager.

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=openmrs_backend
# Bind database to localhost only. Leave empty in production and do not publish the DB port.
POSTGRES_PORT=127.0.0.1:5432

# --- API ---
API_PORT=5111
ASPNETCORE_ENVIRONMENT=Development

# --- Security ---
# 32-byte AES-256 key. Generate with:
# powershell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# bash: openssl rand -base64 32
SECURITY_ENCRYPTION_KEY=

# --- OpenMRS webhook ---
OPENMRS_WEBHOOK_SECRET=
OPENMRS_WEBHOOK_ALLOWED_CLOCK_SKEW_MINUTES=5

# --- JWT ---
# Minimaal 32 tekens voor HMAC-SHA256
JWT_SECRET=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3001

# --- RabbitMQ (optioneel — leeg laten voor in-memory transport in dev) ---
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_USERNAME=
# RABBITMQ_PASSWORD=

# --- Encryptie (AES-256-GCM) ---
# Genereer met: openssl rand -base64 32
ENCRYPTION_KEY=

# --- OpenMRS ---
OPENMRS_BASE_URL=http://host.docker.internal:3032
OPENMRS_USERNAME=
OPENMRS_PASSWORD=

# --- OpenMRS poll-worker (alternatief voor inbound webhook) ---
# Zet op true wanneer de OpenMRS-distro geen webhookmodule firet:
# de backend trekt dan periodiek encounters uit FHIR en plant zelf reminders.
OPENMRS_POLLER_ENABLED=true
OPENMRS_POLLER_INTERVAL_MINUTES=5
OPENMRS_POLLER_LOOKAHEAD_HOURS=48
OPENMRS_POLLER_ORGANIZATION_ID=openmrs-local

# --- Messaging providers (FakeComWorld testomgeving) ---
# Start providers met: docker run -p 1337:8080 ghcr.io/avansict/in2.4-fakecomworld:main
MESSAGING_PROVIDERS_BASE_URL=http://host.docker.internal:1337
MESSAGING_STUDENT_GROUP=groep-1

# SwiftSend
MESSAGING_SWIFTSEND_APIKEY=

# SecurePost
MESSAGING_SECUREPOST_CLIENT_ID=
MESSAGING_SECUREPOST_CLIENT_SECRET=

# LegacyLink
MESSAGING_LEGACYLINK_USERNAME=
MESSAGING_LEGACYLINK_PASSWORD=

# AsyncFlow
MESSAGING_ASYNCFLOW_APIKEY=
