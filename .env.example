# Copy this file to .env and fill in real values.
# Keep .env local: it is git-ignored and contains secrets.

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=openmrs_backend
# Local override only. Production compose does not expose the database port.
POSTGRES_PORT=127.0.0.1:5432

# --- API ---
API_PORT=127.0.0.1:5111
ASPNETCORE_ENVIRONMENT=Development
ALLOWED_ORIGINS=http://localhost:3032

# --- Authentication and encryption ---
# JWT secret: at least 32 characters.
JWT_SECRET=
# Generate each encryption key separately with: openssl rand -base64 32
SECURITY_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# --- Bootstrapped admin ---
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
ALLOW_PUBLIC_REGISTRATION=false

# --- Durable broker ---
# RabbitMQ is required by docker-compose and by non-development deployments.
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=openmrs_backend
RABBITMQ_PASSWORD=

# --- Multi-hospital JSON configuration ---
# See hospital-config.example.json. Mount the file into the API container when
# using Docker, then set this to its container path. Leave empty to seed the
# legacy single-hospital configuration below.
HOSPITAL_CONFIG_FILE_PATH=

# --- Legacy single-hospital seed ---
OPENMRS_ORGANIZATION_ID=hospital-a
OPENMRS_BASE_URL=http://host.docker.internal:3032
OPENMRS_USERNAME=
OPENMRS_PASSWORD=
OPENMRS_WEBHOOK_SECRET=
OPENMRS_WEBHOOK_ALLOWED_CLOCK_SKEW_MINUTES=5
OPENMRS_POLLER_ENABLED=true
OPENMRS_POLLER_INTERVAL_MINUTES=5
OPENMRS_POLLER_LOOKAHEAD_HOURS=48

# --- Legacy provider seed (FakeComWorld test environment) ---
# Start providers with: docker run -p 1337:8080 ghcr.io/avansict/in2.4-fakecomworld:main
MESSAGING_PROVIDERS_BASE_URL=http://host.docker.internal:1337
MESSAGING_STUDENT_GROUP=groep-1
MESSAGING_SWIFTSEND_APIKEY=
MESSAGING_SECUREPOST_CLIENT_ID=
MESSAGING_SECUREPOST_CLIENT_SECRET=
MESSAGING_LEGACYLINK_USERNAME=
MESSAGING_LEGACYLINK_PASSWORD=
MESSAGING_ASYNCFLOW_APIKEY=
