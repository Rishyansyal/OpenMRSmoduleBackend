# Kopieer dit bestand naar .env en vul de echte waarden in.
# Het .env bestand is git-ignored. Bewaar credentials ALLEEN lokaal of in een wachtwoordmanager.

# --- PostgreSQL ---
POSTGRES_USER=openmrs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openmrs
POSTGRES_PORT=5432

# --- API ---
API_PORT=5111
ASPNETCORE_ENVIRONMENT=Development

# --- JWT ---
# Minimaal 32 tekens voor HMAC-SHA256
JWT_SECRET=change-me-to-a-long-random-secret-32chars

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3001

# --- OpenMRS ---
OPENMRS_BASE_URL=http://host.docker.internal:3032
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123

# --- Messaging providers (FakeComWorld testomgeving) ---
# Start providers met: docker run -p 1337:8080 ghcr.io/avansict/in2.4-fakecomworld:main
MESSAGING_PROVIDERS_BASE_URL=http://host.docker.internal:1337
MESSAGING_STUDENT_GROUP=groep-1

# SwiftSend
MESSAGING_SWIFTSEND_APIKEY=your-api-key-here

# SecurePost
MESSAGING_SECUREPOST_CLIENT_ID=securepost-client-id
MESSAGING_SECUREPOST_CLIENT_SECRET=securepost-secret-key

# LegacyLink
MESSAGING_LEGACYLINK_USERNAME=legacylink-user
MESSAGING_LEGACYLINK_PASSWORD=legacylink-password

# AsyncFlow
MESSAGING_ASYNCFLOW_APIKEY=asyncflow-api-key
