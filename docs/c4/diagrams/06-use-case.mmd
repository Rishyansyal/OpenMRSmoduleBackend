flowchart LR
    classDef actor fill:#d0ebff,stroke:#1971c2,color:#111
    classDef usecase fill:#d3f9d8,stroke:#2b8a3e,color:#111
    classDef ext fill:#f1f3f5,stroke:#495057,color:#111

    clinician["Clinician"]:::actor
    admin["Admin / API client"]:::actor
    patient["Patient"]:::actor
    openmrs["OpenMRS O3"]:::ext
    provider["Messaging provider"]:::ext

    uc1(["Create/update appointment in OpenMRS O3"]):::usecase
    uc2(["Send signed appointment event"]):::usecase
    uc3(["Schedule 24h and 1h reminders"]):::usecase
    uc4(["Deliver reminder through configured provider"]):::usecase
    uc5(["Login with bootstrapped admin"]):::usecase
    uc6(["Send ad-hoc message through explicit provider"]):::usecase
    uc7(["Inspect health, metrics, and history"]):::usecase

    clinician --> uc1
    uc1 --> openmrs
    openmrs --> uc2
    uc2 --> uc3
    uc3 --> uc4
    uc4 --> provider
    provider --> patient
    admin --> uc5
    admin --> uc6
    admin --> uc7
