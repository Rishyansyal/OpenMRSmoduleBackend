flowchart TB
    classDef config fill:#fff3bf,stroke:#f08c00,color:#111
    classDef db fill:#d3f9d8,stroke:#2b8a3e,color:#111
    classDef api fill:#d0ebff,stroke:#1971c2,color:#111
    classDef ext fill:#f1f3f5,stroke:#495057,color:#111

    json["HospitalConfiguration:Organizations JSON<br/>org id, OpenMRS URL, credentials, webhook secret, provider configs, retry policy"]:::config
    legacy["Legacy env config<br/>OpenMrs:*, Webhooks:OpenMrs:*, Messaging:*<br/>used only when JSON org list is empty"]:::config
    seeder["OrganizationConfigSeeder<br/>startup upsert"]:::api
    orgs[("organization_integration_configs<br/>encrypted OpenMRS credentials and webhook secret")]:::db
    providers[("organization_provider_configs<br/>encrypted provider credential JSON")]:::db
    repo["OrganizationConfigRepository<br/>runtime lookup by organization id"]:::api
    omrsA["OpenMRS O3 hospital A"]:::ext
    omrsB["OpenMRS O3 hospital B"]:::ext
    backend["Backend services<br/>webhook validation, FHIR calls, reminders"]:::api

    json --> seeder
    legacy --> seeder
    seeder --> orgs
    seeder --> providers
    orgs --> repo
    providers --> repo
    omrsA -->|"X-OpenMRS-Organization-Id: hospital-a"| backend
    omrsB -->|"X-OpenMRS-Organization-Id: hospital-b"| backend
    backend --> repo
    backend -->|"organization-specific FHIR credentials"| omrsA
    backend -->|"organization-specific FHIR credentials"| omrsB
